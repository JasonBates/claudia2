{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /*
   * src/__tests__/node holds Node-side integration harnesses (e.g. spawning the
   * SDK bridge). They need Node globals this config deliberately omits — the
   * frontend runs in a webview and shouldn't typecheck against `process`, `fs`,
   * etc. Vitest still runs them; they're just outside the DOM-only check.
   */
  "exclude": ["src/__tests__/node"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
